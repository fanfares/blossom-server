{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fanfares-blossom-server",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-24",
  "containers": [
    {
      "class_name": "BlossomAppContainer",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BLOSSOM_APP",
        "class_name": "BlossomAppContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BlossomAppContainer"
      ]
    }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "4e84c1691dd1a8230152bfc2551cec85",
    "R2_BUCKET": "ff-blossom-test",
    "BLOSSOM_PUBLIC_DOMAIN": ""
    // Admin credentials are deliberately NOT declared here. Vars and secrets
    // share one namespace, so an empty var overwrites a secret on every deploy.
    // Set the dashboard password with: wrangler secret put BLOSSOM_ADMIN_PASSWORD
    // Also set the independent signing key with:
    // wrangler secret put BLOSSOM_ADMIN_SESSION_SECRET
    // The edge-only metadata reindex endpoint uses a third independent secret:
    // wrangler secret put BLOSSOM_META_ADMIN_TOKEN
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "blossom_metadata",
      "database_name": "blossom-metadata",
      "database_id": "3cbdd7aa-6ba6-4870-af9b-dcf2d540e0f4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOSSOM_R2",
      "bucket_name": "ff-blossom-test"
    }
  ]
}
