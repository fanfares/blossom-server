{
  // Standalone config for the STAGING worker (fanfares-blossom-server-staging),
  // fully isolated from the worker behind blossom.fanfares.live: its own
  // container image (staging config baked in: paid storage ON at 1 sat), its
  // own R2 bucket, D1 database, and Turso database.
  //
  // One-time setup, run from this directory:
  //   npx wrangler r2 bucket create ff-blossom-staging
  //   npx wrangler d1 create blossom-metadata-staging
  //   npx wrangler d1 execute blossom-metadata-staging --remote \
  //     --file scripts/d1/schema.sql --config wrangler.staging.jsonc
  //   The canonical hostname is staging.blossom.fanfares.live. Wrangler creates
  //   and manages its DNS record as a Worker Custom Domain during deployment.
  //   npx wrangler secret put TURSO_DATABASE_URL --config wrangler.staging.jsonc
  //   npx wrangler secret put TURSO_AUTH_TOKEN --config wrangler.staging.jsonc
  //   npx wrangler secret put R2_ACCESS_KEY_ID --config wrangler.staging.jsonc
  //   npx wrangler secret put R2_SECRET_ACCESS_KEY --config wrangler.staging.jsonc
  //     (use a dedicated key scoped to ff-blossom-staging; do not reuse the
  //      production R2 credential pair)
  //
  // Deploy / redeploy:
  //   npx wrangler deploy --config wrangler.staging.jsonc
  //
  // Verify:
  //   GET https://<BLOSSOM_PUBLIC_DOMAIN>/            -> 200, title ends "(staging)"
  //   GET https://<BLOSSOM_PUBLIC_DOMAIN>/storage/account -> 401 (never 404)
  "$schema": "node_modules/wrangler/config-schema.json",
  // This is a deployment guardrail, not an application variable. It makes a
  // login for any other Cloudflare account fail instead of creating staging
  // resources beside unrelated Workers.
  "account_id": "4e84c1691dd1a8230152bfc2551cec85",
  "name": "fanfares-blossom-server-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-24",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "staging.blossom.fanfares.live",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "BlossomAppContainer",
      "image": "./Dockerfile.cloudflare.staging",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BLOSSOM_APP",
        "class_name": "BlossomAppContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BlossomAppContainer"
      ]
    }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "4e84c1691dd1a8230152bfc2551cec85",
    "R2_BUCKET": "ff-blossom-staging",
    "BLOSSOM_PUBLIC_DOMAIN": "staging.blossom.fanfares.live"
    // BLOSSOM_ADMIN_PASSWORD stays a secret, never a var (an empty var
    // overwrites the secret on every deploy — vars and secrets share a
    // namespace).
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "blossom_metadata",
      "database_name": "blossom-metadata-staging",
      "database_id": "7b062120-95d6-4b7b-b0e2-2a4d4cbfe6f7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOSSOM_R2",
      "bucket_name": "ff-blossom-staging"
    }
  ]
}
